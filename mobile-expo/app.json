{
  "expo": {
    "name": "SSS Bank",
    "slug": "sss-bank-mobile",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#041415"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sssbank.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#041415"
      },
      "package": "com.sssbank.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
